# q198: the surface glow scans' cell cache (b/perf-glowcache a5daa65). q191's profile had the near and far glow scans
# at 30 and 23 ms of worker time a frame through the townwalk, re-placing their whole discs every 4 m / 24 m. Townwalk,
# 4 rounds: C a5daa65, O a5daa65 with -oldglow (the cache off, same build), N main 5cfcda6. Then one -glowcheck game
# (any cell that differs from a full scan is logged) and a profiled townwalk on C for the glow jobs' worker time.
Q=q198; TITLE="Surface glow cell cache"
BUILDS="a5daa65"
VIEWS="townwalk"
view() { echo "-hitchms 100 -benchwait 100 -benchstops townwalk"; }
ARMS="C O N"
arm() { case $1 in C) echo "Profile-a5daa65";; O) echo "Profile-a5daa65 -oldglow";; N) echo "Profile-5cfcda6";; esac; }
ROUNDS=4; GFX="High"; REF=N; BAR=1; RUNTIMEOUT=900
after() {
  [ -n "${DRY:-}" ] && return
  local f
  for f in "$R"/q-$Q-townwalk-*-cs100-*.log; do echo "$(basename $f .log): $(grep -a '^BenchRoute: townwalk: avg' $f | grep -o '1% low [0-9.]* fps\|worst [0-9.]* ms' | tr '\n' ' ') hitches $(grep -ac 'BenchRoute: hitch' $f), at x 3250-3300: $(grep -a 'BenchRoute: hitch' $f | awk -F'player ' '{split($2,a,","); if (a[1]>=3250 && a[1]<=3300) n++} END{print n+0}') exc $(grep -ac 'Exception' $f) nan $(grep -aic '\bnan\b' $f)"; done
  RUNTIMEOUT=900 BENCHW=1920 BENCHH=1080 runcsv Profile-a5daa65 $Q-check a5daa65 s100 1 -gfx High -fpscap 0 \
    -hitchms 100 -benchwait 100 -benchstops townwalk -glowcheck
  echo "== glowcheck"; grep -a 'glowcheck' "$R/q-$Q-check-cs100-1.log" | head -30
  echo "differing scans: $(grep -a 'glowcheck' "$R/q-$Q-check-cs100-1.log" | grep -vc ': 0 cells differ')"
  local o=Profile-a5daa65 t=$Q-prof-townwalk-cs100-1 spot=townwalk
  RUNTIMEOUT=900 BENCHW=1920 BENCHH=1080 runcsv $o $Q-prof-$spot a5daa65 s100 1 -gfx High -fpscap 0 \
    -hitchms 100 -benchwait 100 -benchstops townwalk -profilestop townwalk "$W/q-$t.raw"
  check "$R/q-$t.log"
  cp "$P/Library/LastSceneManagerSetup.txt" "$R/LastSceneManagerSetup.bak" 2>/dev/null
  cp "$B/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs"
  ( cd "$P" && timeout 3600 "$UNITY" -batchmode -projectPath "$(cygpath -m $P)" -executeMethod BProfileTools.Analyze \
      -raws "$(cygpath -w "$R/q-$t.raw")" -out "$(cygpath -w "$R/$Q-prof-$spot.txt")" -over 500 -logFile "$W/analyze-$Q-$spot.log" )
  cp "$R/LastSceneManagerSetup.bak" "$P/Library/LastSceneManagerSetup.txt" 2>/dev/null
  rm -f "$P/Assets/Game/Scripts/Editor/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs.meta"; strays >/dev/null
  [ -f "$R/$Q-prof-$spot.txt" ] && rm -f "$R"/q-$Q-prof-*.raw
  echo "== glow and worker rows, $spot"; grep -a 'SurfaceGlow\|BuildChunkMeshJob\|CaveSystem:\|CreatureRenderSystem\|ThirdPersonCamera' "$R/$Q-prof-$spot.txt" | grep -v '^SPIKE' | cut -c1-150
  echo "== spikes"; grep -a '^SPIKE' "$R/$Q-prof-$spot.txt" | head -25 | cut -c1-150
}
