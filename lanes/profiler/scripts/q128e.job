# Third rebuild of B for job 86 (q128e): q128d cleared Library/ShaderCache, but the player build still compiled none of
# the game's shaders (they come from the build's own caches), so B would again carry the variants from q128b's FXC crash.
# B is now 5317827: ce3ff5a plus one unused constant in TerrainSurface.shader's ForwardLit pass (a local bench-only
# commit, refs/bench/rehash-ce3ff5a, not pushed). Its source hash is new, so no cache can serve it: it compiles fresh,
# and an FXC crash that is really the shader's would come back. before() stops unless it compiled with no crash.
# Second rebuild of B for job 86 (q128d): q128c's rebuild compiled nothing and reused the shader cache left by the
# crashed FXC run, so B again had no terrain. The chain moves Library/ShaderCache aside for this job and puts it back after.
# Earlier: rebuild of B for job 86: q128b's B build hit 'Lost connection with shader compiler process. Suspected crash in FXC'
# on TerrainSurface ForwardLit and shipped without terrain. Before the games, stop if the crash repeats.
# Rerun 11-15: B = ce3ff5a7 (BC1091 fixed), A = 5b953a34 (its merge-base with main; the diff is the 6 cobble files).
# Job 86 (R-28 row 2, #312): cobble bevel parallax and stone normals. render/cobble-depth ce3ff5a8 (B) vs main 5b953a3a
# (A, shelf). Medium and High, noon, Clear, 3 rounds. Views: the desert town square (-benchspot -342,560, yaw 0) and
# town 73 centre (-benchspot 2972,-885, yaw 0). Whole-frame GPU here; terrain GPU needs a pass split (RenderDoc), not
# taken by this spec. Terrain mesh memory from the runner's "mesh N MB" field.
Q=q128e; TITLE="job 86 cobble parallax"
BUILDS="5317827 5b953a3"
VIEWS="desert town"
view() { case $1 in
  desert) echo "-goto -342,560 -benchstops spot -benchspot -342,560,0 -benchhour 12 -benchweather Clear";;
  town)   echo "-goto 2972,-885 -benchstops spot -benchspot 2972,-885,0 -benchhour 12 -benchweather Clear";; esac; }
ARMS="B A"
arm() { case $1 in B) echo "Profile-5317827";; A) echo "Profile-5b953a3";; esac; }
ROUNDS=3; GFX="Medium High"; REF=A; BAR=0.1
before() {
  [ -n "${DRY:-}" ] && return
  local f="$R/build-Profile-5317827.log" n c; n=$(grep -ac "Suspected crash in FXC" "$f"); c=$(grep -ac 'Compiling shader "Punchy/Terrain Surface"' "$f")
  echo "FXC crashes in the rebuild: $n; terrain shader compiled: $c"
  [ "$n" = 0 ] && [ "$c" != 0 ] || { echo "terrain shader not cleanly compiled: not running the games"; exit 1; }
}
