# The water stops are now the slowest on the route at High (q179: river 41 ms GPU, lake and stormshore ~34 ms,
# forest 23.6 as a reference). Main 0f9a72d, one game per stop for the frame numbers, then two RenderDoc frames per
# stop split by pass (rdpasses.py, as q120).
Q=q180; TITLE="Water stops GPU by pass"
BUILDS="0f9a72d"
VIEWS="river lake stormshore forest"
view() { echo "-hitchms 200 -benchstops $1"; }
ARMS="M"
arm() { echo "Profile-0f9a72d"; }
ROUNDS=1; GFX="High"; REF=M; BAR=1; RUNTIMEOUT=900
after() {
  [ -n "${DRY:-}" ] && return
  local RDC="/c/Program Files/RenderDoc/renderdoccmd.exe" QRD="/c/Program Files/RenderDoc/qrenderdoc.exe" RD="$R/rd180" v
  mkdir -p "$RD"; rm -f "$RD"/*.rdc
  for v in $VIEWS; do
    fixed Profile-0f9a72d || return 1; cool
    ( cd "$P/Builds/Bench" && timeout 900 "$RDC" capture -w -d "$(cygpath -w "$P/Builds/Bench")" -c "$(cygpath -w "$RD/$v")" \
        "$(cygpath -w "$P/Builds/Bench/Punchy.exe")" -logFile "$W/q-$Q-rd-$v.log" -benchroute -weatherseed 4 -time 12 -body ${BENCHBODY:-default} \
        $(screen Bench 1920 1080) -gfx High -fpscap 0 -benchstops $v -renderdocstop $v 2 >/dev/null 2>&1 )
    strays >/dev/null; check "$R/q-$Q-rd-$v.log"
    echo "rd $v: $(grep -ah 'RenderDoc capture' "$R/q-$Q-rd-$v.log" | tr '\n' ' ' | cut -c1-200)"
  done
  local CAPS=$(ls "$RD"/*.rdc 2>/dev/null | xargs -n1 cygpath -w | tr '\n' ';')
  [ -n "$CAPS" ] && RD_CAPS="$CAPS" RD_OUT="$(cygpath -w "$R/$Q-passes.txt")" RD_MAXDEPTH=6 RD_TOPDRAWS=15 timeout 3600 "$QRD" --python "$(cygpath -w "$S/rdpasses.py")" >/dev/null 2>&1
  echo "qrenderdoc rc=$?"; strays >/dev/null
  ls -la "$RD"
}
