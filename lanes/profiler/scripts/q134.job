# Job 92, B1 (A-115 row 1, #315): lamplighter glow. fauna/lamplighter a96f48d8 (B, merged as #374) vs its base 4006cab3
# (A). Built here. Medium and High, Clear, 3 rounds: town 73 (HumanVillage) from 100 m north facing it at 19.2 h, while
# the lamps light street by street. After: a Profiler game per arm (SurfaceGlow rescans and ms).
Q=q134; TITLE="job 92 B1 lamplighter"
BUILDS="a96f48d 4006cab"
VIEWS="dusk"
view() { case $1 in dusk) echo "-goto 2972,-785 -benchstops spot -benchspot 2972,-785,180 -benchlong spot 60 -benchhour 19.2 -benchweather Clear";; esac; }
ARMS="B A"
arm() { case $1 in B) echo "Profile-a96f48d";; A) echo "Profile-4006cab";; esac; }
ROUNDS=3; GFX="Medium High"; REF=A; BAR=0.3
after() {
  [ -n "${DRY:-}" ] && return   # (a dry run must not launch games or Unity)
  for a in B A; do
    local spec o t; spec=$(arm $a); o=${spec%% *}; t=$Q-prof-$a-cs100-1
    BENCHW=1920 BENCHH=1080 runcsv $o $Q-prof-$a ${o#Profile-} s100 1 -gfx Medium -fpscap 0 $(view dusk) ${spec#$o} \
      -profiler-enable -profiler-log-file "$W/q-$t.raw" -profiler-maxusedmemory 1073741824
    check "$R/q-$t.log"
    cp "$P/Library/LastSceneManagerSetup.txt" "$R/LastSceneManagerSetup.bak" 2>/dev/null
    cp "$B/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs"
    ( cd "$P" && timeout 3000 "$UNITY" -batchmode -projectPath "$(cygpath -m $P)" -executeMethod BProfileTools.Analyze \
        -raws "$(cygpath -w "$R/q-$t.raw")" -out "$(cygpath -w "$R/$t.txt")" -over 8 -keep SurfaceGlow -logFile "$W/analyze-$t.log" )
    cp "$R/LastSceneManagerSetup.bak" "$P/Library/LastSceneManagerSetup.txt" 2>/dev/null
    rm -f "$P/Assets/Game/Scripts/Editor/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs.meta"; strays >/dev/null
    [ -f "$R/$t.txt" ] && rm -f "$R/q-$t.raw"
    echo "== $t"; grep -a "SurfaceGlow\|frames used" "$R/$t.txt" | head -8
  done
}
