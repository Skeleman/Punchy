# Job 83 (A-110 row 5): far town folk on low-rate brains. fauna/one-population f1747057 (B, row 5) vs 3d0c8df2 (A,
# row 4). Shelf builds. Medium, 10:00, Clear, 3 rounds. Views: town 73 centre (-benchspot 2972,-885, yaw 0) and 200 m
# north facing the town (-benchspot 2972,-685,180). After: one Profiler-captured centre game per arm (CreatureMind and
# the director's main-thread samples). The [members] line gives legs/full counts.
Q=q125; TITLE="job 83 low-rate brains"
BUILDS="f174705 3d0c8df"
VIEWS="centre north"
view() { case $1 in
  centre) echo "-goto 2972,-885 -benchstops spot -benchspot 2972,-885,0 -benchhour 10 -benchweather Clear";;
  north)  echo "-goto 2972,-685 -benchstops spot -benchspot 2972,-685,180 -benchhour 10 -benchweather Clear";; esac; }
ARMS="B A"
arm() { case $1 in B) echo "Profile-f174705";; A) echo "Profile-3d0c8df";; esac; }
ROUNDS=3; GFX=Medium; REF=A
after() {
  for a in B A; do
    local spec o t; spec=$(arm $a); o=${spec%% *}; t=$Q-prof-$a-cs100-1
    BENCHW=1920 BENCHH=1080 runcsv $o $Q-prof-$a ${o#Profile-} s100 1 -gfx Medium -fpscap 0 $(view centre) ${spec#$o} \
      -profiler-enable -profiler-log-file "$W/q-$t.raw" -profiler-maxusedmemory 1073741824
    check "$R/q-$t.log"
    cp "$P/Library/LastSceneManagerSetup.txt" "$R/LastSceneManagerSetup.bak" 2>/dev/null
    cp "$B/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs"
    ( cd "$P" && timeout 3000 "$UNITY" -batchmode -projectPath "$(cygpath -m $P)" -executeMethod BProfileTools.Analyze \
        -raws "$(cygpath -w "$R/q-$t.raw")" -out "$(cygpath -w "$R/$t.txt")" -over 8 -keep Creature -logFile "$W/analyze-$t.log" )
    cp "$R/LastSceneManagerSetup.bak" "$P/Library/LastSceneManagerSetup.txt" 2>/dev/null
    rm -f "$P/Assets/Game/Scripts/Editor/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs.meta"; strays >/dev/null
    [ -f "$R/$t.txt" ] && rm -f "$R/q-$t.raw"
    echo "== $t"; grep -a "CreatureMind\|Brain\|Director\|frames used" "$R/$t.txt" | head -8
  done
}
