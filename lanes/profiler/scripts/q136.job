# Job 95 (A-124 row 1, #358): one build per person, crowd cost. fauna/individual-builds, merged as db79d9f8 (B, #387)
# vs its first parent 509022e4 (A). Medium, noon, Clear, 3 rounds, launched straight into town 73's centre (fresh load
# each game) and held 60 s. Load from each log's "[fauna build]" lines. After: one Profiler game per arm,
# CreatureRenderSystem and FaunaDirector kept.
Q=q136; TITLE="job 95 builds per person"
BUILDS="db79d9f 509022e"
VIEWS="town"
view() { echo "-goto 2972,-885 -benchstops spot -benchspot 2972,-885,0 -benchhour 12 -benchweather Clear"; }
ARMS="B A"
arm() { case $1 in B) echo "Profile-db79d9f";; A) echo "Profile-509022e";; esac; }
ROUNDS=3; GFX="Medium"; REF=A; BAR=0.2
after() {
  [ -n "${DRY:-}" ] && return   # (a dry run must not launch games or Unity)
  for f in "$L"/q-$Q-town-*-cs100-*.log; do echo "== $(basename $f): $(grep -ah '\[fauna build\]' $f | cut -c1-220 | tr '\n' ' ')"; done
  for a in B A; do
    local spec o t; spec=$(arm $a); o=${spec%% *}; t=$Q-prof-$a-cs100-1
    BENCHW=1920 BENCHH=1080 runcsv $o $Q-prof-$a ${o#Profile-} s100 1 -gfx Medium -fpscap 0 $(view town) \
      -profiler-enable -profiler-log-file "$W/q-$t.raw" -profiler-maxusedmemory 1073741824
    check "$R/q-$t.log"
    cp "$P/Library/LastSceneManagerSetup.txt" "$R/LastSceneManagerSetup.bak" 2>/dev/null
    cp "$B/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs"
    ( cd "$P" && timeout 3000 "$UNITY" -batchmode -projectPath "$(cygpath -m $P)" -executeMethod BProfileTools.Analyze \
        -raws "$(cygpath -w "$R/q-$t.raw")" -out "$(cygpath -w "$R/$t.txt")" -over 8 -keep Creature -logFile "$W/analyze-$t.log" )
    cp "$R/LastSceneManagerSetup.bak" "$P/Library/LastSceneManagerSetup.txt" 2>/dev/null
    rm -f "$P/Assets/Game/Scripts/Editor/BProfileTools.cs" "$P/Assets/Game/Scripts/Editor/BProfileTools.cs.meta"; strays >/dev/null
    [ -f "$R/$t.txt" ] && rm -f "$R/q-$t.raw"
    echo "== $t"; grep -a "Creature\|FaunaDirector\|frames used" "$R/$t.txt" | grep -v ^OVER | head -10
  done
}
