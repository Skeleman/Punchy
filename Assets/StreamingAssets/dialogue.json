{
  "_readme_jobs": "A-29: a line's \"trade\" can name a job (FolkJob: Smith, Baker, Healer, Herder, Farmer, Trader, Guard, Fisher, RoostKeeper, Tanner, Forager, PoolFisher...) as well as a task; folk with a job say a line from its pool most of the time, in talk and to the player. \"mood\": Cheerful, Plain or Grumpy (from the folk, or Grumpy/Cheerful when wary/warm of the player).",
  "_readme": [
    "What folk say as you walk by. Edit freely while the game runs: it is read again a second after you save.",
    "cultures: one entry per species name (Human, HumanChild, Dwarf, Elf, Goblin, Ogre, Hermit), then the species it is based on, then Any.",
    "words: lists the {slots} pick from. A culture's own list wins over Any's. Words may hold slots of their own.",
    "lines: a plain string, or an object: text, and optionally when (day, night, dawn, morning, afternoon, evening), trade (one or a list), weight (default 1), emote (Wave, Bow, Cheer, Dance: an answer to it, never said walking by).",
    "Built-in slots: {trade} (from the words trade.Hammer, trade.Fish...), {home_town}, {species}, {player} (your body), {time_of_day} (or the words time.morning...).",
    "A line whose slot can't be filled (no home town, out on the road) is skipped. town_start + town_end name each town.",
    "Unknown keys are kept for later (dialogue options), so adding them does no harm."
  ],
  "format": 1,
  "cultures": {
    "Any": {
      "words": {
        "trade.Hammer": ["smith"],
        "trade.Chop": ["woodcutter"],
        "trade.Gesture": ["trader"],
        "trade.Tend": ["well-keeper"],
        "trade.Watch": ["gatekeeper"],
        "trade.Hunt": ["hunter"],
        "trade.Patrol": ["guard"],
        "trade.Fish": ["fisher"],
        "trade.Mine": ["miner"],
        "trade.Travel": ["traveller"],
        "trade.Camper": ["traveller"],
        "weather_word": ["fair", "fine", "still"],
        "town_start": ["Ash", "Oak", "Mill", "Stone", "Brook", "Thorn", "Elm", "Hollow"],
        "town_end": ["ford", "by", "stead", "wick", "field", "well", "ton", "dale"]
      },
      "lines": [
        "Mind how you go.",
        "{time_of_day}'s a {weather_word} one.",
        { "text": "Is that a {player}? Odd company.", "weight": 0.5 },
        { "text": "Late to be about.", "when": "night" },
        { "text": "Back to the forge with me.", "trade": "Hammer" },
        { "text": "Nothing biting today.", "trade": "Fish" },
        { "text": "The road's long but it's good.", "trade": ["Travel", "Camper"] },
        { "text": "{culture_greeting}!", "emote": "Wave" },
        { "text": "Oh! Hello.", "emote": "Wave" },
        { "text": "No need to bow to me.", "emote": "Bow" },
        { "text": "Ha! Yes!", "emote": "Cheer" },
        { "text": "Now that's a dance!", "emote": "Dance" },
        { "text": "Good to see one of our own.", "stance": "Kin" },
        { "text": "Ah, family. Welcome.", "stance": "Kin" },
        { "text": "Well met, friend.", "stance": "Warm" },
        { "text": "Bread's in the oven, mind the heat.", "trade": "Baker" },
        { "text": "First loaves were out before dawn.", "trade": "Baker" },
        { "text": "Flour on everything. Always.", "trade": "Baker" },
        { "text": "Smell that? Fresh rolls.", "trade": "Baker", "mood": "Cheerful" },
        { "text": "Everyone wants bread, nobody wants to knead.", "trade": "Baker", "mood": "Grumpy" },
        { "text": "The hearth's hot enough for another batch.", "trade": "Baker" },
        { "text": "Honey cakes later, if the bees allow.", "trade": "Baker", "mood": "Cheerful" },
        { "text": "Sit a while, you look worn through.", "trade": "Healer" },
        { "text": "Willow bark for the ache, nettle for the rest.", "trade": "Healer" },
        { "text": "Another scraped knee from the woodpile.", "trade": "Healer" },
        { "text": "Keep that cut clean, now.", "trade": "Healer" },
        { "text": "Everyone's mending nicely this {time_of_day}.", "trade": "Healer", "mood": "Cheerful" },
        { "text": "If one more fool walks into a beehive...", "trade": "Healer", "mood": "Grumpy" },
        { "text": "Herbs dry best in a {weather_word} wind.", "trade": "Healer" },
        { "text": "Counted them twice. All here.", "trade": "Herder" },
        { "text": "That one always strays to the hedge.", "trade": "Herder" },
        { "text": "Easy now, they spook at strangers.", "trade": "Herder" },
        { "text": "Good grazing this year.", "trade": "Herder", "mood": "Cheerful" },
        { "text": "Muddy pen, muddy boots, muddy everything.", "trade": "Herder", "mood": "Grumpy" },
        { "text": "Fences hold the beasts, not the foxes.", "trade": "Herder" },
        { "text": "Rows won't hoe themselves.", "trade": "Farmer" },
        { "text": "Could do with rain, honestly.", "trade": "Farmer" },
        { "text": "Turnips are coming up fat.", "trade": "Farmer", "mood": "Cheerful" },
        { "text": "Crows again. Every single morning.", "trade": "Farmer", "mood": "Grumpy" },
        { "text": "The soil round {home_town} is kind.", "trade": "Farmer" },
        { "text": "Plant in spring, ache all summer.", "trade": "Farmer" },
        { "text": "Fair prices, mostly.", "trade": "Trader" },
        { "text": "Look, don't touch. Unless you're buying.", "trade": "Trader" },
        { "text": "Best goods this side of {home_town}!", "trade": "Trader", "mood": "Cheerful" },
        { "text": "Trade's been slow. Very slow.", "trade": "Trader", "mood": "Grumpy" },
        { "text": "Got this from a traveller up the road.", "trade": "Trader" },
        { "text": "A {player} customer? That's new.", "trade": "Trader" },
        { "text": "Road's clear today.", "trade": "Guard" },
        { "text": "Keep to the paths after dark.", "trade": "Guard" },
        { "text": "Wolves were seen past the ridge.", "trade": "Guard" },
        { "text": "Quiet watch is a good watch.", "trade": "Guard", "mood": "Cheerful" },
        { "text": "Move along. Nothing to see.", "trade": "Guard", "mood": "Grumpy" },
        { "text": "I walk this round a hundred times a day.", "trade": "Guard" },
        { "text": "Fish are deep when the sun's high.", "trade": "Fisher" },
        { "text": "The water's {weather_word} today.", "trade": "Fisher" },
        { "text": "Caught one this long! Well, nearly.", "trade": "Fisher", "mood": "Cheerful" },
        { "text": "Lost another hook to that log.", "trade": "Fisher", "mood": "Grumpy" },
        { "text": "Quiet now, you'll scare them off.", "trade": "Fisher" },
        { "text": "Eel for supper, if I'm lucky.", "trade": "Fisher" },
        { "text": "Hot work, the forge.", "trade": "Smith" },
        { "text": "Bring me iron and I'll make it useful.", "trade": "Smith" },
        { "text": "Strike while it glows, that's the trick.", "trade": "Smith" },
        { "text": "Lovely ring to the anvil today.", "trade": "Smith", "mood": "Cheerful" },
        { "text": "Bent nails, bent tools, bent patience.", "trade": "Smith", "mood": "Grumpy" },
        { "text": "Every hinge in {home_town} is mine.", "trade": "Smith" },
        { "text": "Mind the chips, they fly.", "trade": "Woodcutter" },
        { "text": "Good dry oak, this.", "trade": "Woodcutter" },
        { "text": "Winter's coming, everyone wants wood.", "trade": "Woodcutter" },
        { "text": "Nothing like a clean split!", "trade": "Woodcutter", "mood": "Cheerful" },
        { "text": "My back's not what it was.", "trade": "Woodcutter", "mood": "Grumpy" },
        { "text": "Stack it bark up, or it rots.", "trade": "Woodcutter" },
        { "text": "Water's sweet today.", "trade": "WellKeeper" },
        { "text": "Mind the rope, it's fraying.", "trade": "WellKeeper" },
        { "text": "Everyone comes by the well sooner or later.", "trade": "WellKeeper" },
        { "text": "Drink up, there's plenty!", "trade": "WellKeeper", "mood": "Cheerful" },
        { "text": "Someone dropped a bucket in. Again.", "trade": "WellKeeper", "mood": "Grumpy" },
        { "text": "Deep and cold, the way a well should be.", "trade": "WellKeeper" },
        { "text": "Who goes there? Oh, just you.", "trade": "Gatekeeper" },
        { "text": "Gate shuts at dusk.", "trade": "Gatekeeper" },
        { "text": "I see everyone who comes into {home_town}.", "trade": "Gatekeeper" },
        { "text": "Welcome, welcome, come on through!", "trade": "Gatekeeper", "mood": "Cheerful" },
        { "text": "State your business. Quickly.", "trade": "Gatekeeper", "mood": "Grumpy" },
        { "text": "Nobody's come up the road all {time_of_day}.", "trade": "Gatekeeper" },
        { "text": "Fine wares, fair prices!", "trade": "Merchant" },
        { "text": "Everything must go!", "trade": "Merchant", "mood": "Cheerful" },
        { "text": "Haggling? Fine, haggle.", "trade": "Merchant", "mood": "Grumpy" },
        { "text": "New stock came in this {time_of_day}.", "trade": "Merchant" },
        { "text": "A {player}! What can I sell you?", "trade": "Merchant" },
        { "text": "Ask about my cloth.", "trade": "Merchant" },
        { "text": "Fresh tracks by the stream.", "trade": "Hunter" },
        { "text": "Downwind, always downwind.", "trade": "Hunter" },
        { "text": "Good hunting today.", "trade": "Hunter", "mood": "Cheerful" },
        { "text": "Lost a whole day to one hare.", "trade": "Hunter", "mood": "Grumpy" },
        { "text": "The deer know my step by now.", "trade": "Hunter" },
        { "text": "Quiet feet fill pots.", "trade": "Hunter" },
        { "text": "There's a seam down there, I can feel it.", "trade": "Miner" },
        { "text": "Dust in my teeth again.", "trade": "Miner", "mood": "Grumpy" },
        { "text": "Struck a good vein today!", "trade": "Miner", "mood": "Cheerful" },
        { "text": "Mind your head in the low bits.", "trade": "Miner" },
        { "text": "Rock talks, if you listen.", "trade": "Miner" },
        { "text": "Daylight's overrated.", "trade": "Miner" },
        { "text": "The pods sway when the colony dreams.", "trade": "RoostKeeper" },
        { "text": "Silk stalks need checking every dusk.", "trade": "RoostKeeper" },
        { "text": "All roosts full, all sleepers safe.", "trade": "RoostKeeper", "mood": "Cheerful" },
        { "text": "Someone's chewed a stalk again.", "trade": "RoostKeeper", "mood": "Grumpy" },
        { "text": "Hush. Daytime is for sleeping.", "trade": "RoostKeeper" },
        { "text": "High roosts are warmest.", "trade": "RoostKeeper" },
        { "text": "Hides dry slow down here.", "trade": "Tanner" },
        { "text": "Scrape, stretch, hang. Scrape, stretch, hang.", "trade": "Tanner" },
        { "text": "This one will make a fine wrap.", "trade": "Tanner", "mood": "Cheerful" },
        { "text": "The smell? You stop noticing. Mostly.", "trade": "Tanner", "mood": "Grumpy" },
        { "text": "The rack holds three if you're careful.", "trade": "Tanner" },
        { "text": "Cave damp is the enemy of leather.", "trade": "Tanner" },
        { "text": "Moths by the glow, beetles by the walls.", "trade": "Forager" },
        { "text": "Basket's half full. Out again soon.", "trade": "Forager" },
        { "text": "Found sweet fungus tonight!", "trade": "Forager", "mood": "Cheerful" },
        { "text": "Nothing out there but cold stone.", "trade": "Forager", "mood": "Grumpy" },
        { "text": "Never forage near the mouth by day.", "trade": "Forager" },
        { "text": "The deep tunnels are kindest.", "trade": "Forager" },
        { "text": "Pale fish in the white pool, blind as stones.", "trade": "PoolFisher" },
        { "text": "Still water, still mind.", "trade": "PoolFisher" },
        { "text": "Three today, plump ones!", "trade": "PoolFisher", "mood": "Cheerful" },
        { "text": "The drips scare them off.", "trade": "PoolFisher", "mood": "Grumpy" },
        { "text": "Feel the ripples, not the light.", "trade": "PoolFisher" },
        { "text": "The pool gives what it gives.", "trade": "PoolFisher" }
      ]
    },
    "Human": {
      "words": {
        "culture_greeting": ["Good {time_of_day}", "Well met", "Hello there"],
        "trade.Hammer": ["smith", "blacksmith"],
        "trade.Gesture": ["trader", "stallkeeper"]
      },
      "lines": [
        { "text": "Best bread in {home_town}, ask anyone.", "trade": "Baker", "mood": "Cheerful" },
        { "text": "Sheep, goats, children. Same work.", "trade": "Herder", "mood": "Grumpy" },
        { "text": "Market day's the best day.", "trade": "Trader" },
        "{culture_greeting}.",
        "{culture_greeting}, stranger.",
        "Welcome to {home_town}.",
        "Not many come through {home_town} these days.",
        { "text": "Best {trade} in {home_town}, that's me.", "trade": ["Hammer", "Gesture", "Fish", "Chop"] },
        { "text": "Fresh catch, if you're hungry.", "trade": "Fish" },
        { "text": "Keep your hands where I can see them.", "trade": ["Patrol", "Watch"] },
        { "text": "Quiet night. Let's keep it that way.", "trade": "Patrol", "when": "night" },
        { "text": "Long day.", "when": "evening" },
        { "text": "{culture_greeting}, friend!", "emote": "Wave" },
        { "text": "Such manners. Welcome to {home_town}.", "emote": "Bow" },
        { "text": "What are we cheering?", "emote": "Cheer" },
        { "text": "Ha, go on then!", "emote": "Dance" },
        { "text": "Not while I'm on duty.", "emote": "Dance", "trade": ["Patrol", "Watch"] },
        { "text": "A {player}. Keep your hands where I can see them.", "stance": "Wary" },
        { "text": "Hm. {player}s don't usually come this way.", "stance": "Wary" },
        { "text": "...", "stance": "Wary", "weight": 0.5},
        { "text": "Not now.", "stance": "Annoyed" },
        { "text": "Go bother someone else, {player}.", "stance": "Annoyed" },
        { "text": "Hmph.", "stance": "Annoyed", "weight": 0.5}
      ]
    },
    "HumanChild": {
      "lines": [
        "Hi!",
        "Want to play?",
        "You can't catch me!",
        { "text": "A {player}! Can I pet it?", "weight": 2 },
        "{home_town} is the best town ever!",
        { "text": "Hi hi hi!", "emote": "Wave" },
        { "text": "Bow! Bow!", "emote": "Bow" },
        { "text": "Yaaay!", "emote": "Cheer" },
        { "text": "I can dance too, look!", "emote": "Dance" }
      ]
    },
    "Dwarf": {
      "words": {
        "culture_greeting": ["Hail", "Stone keep you", "Well met, tall one"],
        "trade.Hammer": ["smith", "forgemaster"],
        "trade.Mine": ["delver", "miner"],
        "town_start": ["Khaz", "Dun", "Barak", "Grim", "Thar"],
        "town_end": ["hold", "deep", "forge", "dum", "gate"]
      },
      "lines": [
        { "text": "Proper dwarf steel, this. None of that soft stuff.", "trade": "Smith" },
        { "text": "Stone ovens bake truest.", "trade": "Baker" },
        { "text": "A dwarf's bread could stop an arrow.", "trade": "Baker", "mood": "Cheerful" },
        { "text": "Tunnel rats in the grain stores. Again.", "trade": "Farmer", "mood": "Grumpy" },
        { "text": "Gold's heavy, but it sells light.", "trade": "Trader" },
        { "text": "Stout salves for stout folk.", "trade": "Healer" },
        "{culture_greeting}.",
        "{culture_greeting}. Mind the beards.",
        "You stand in {home_town}. Wipe your feet.",
        "Good stone round {home_town}. The best.",
        { "text": "Ore's running thick today.", "trade": "Mine" },
        { "text": "A {trade}'s work is never done.", "trade": ["Hammer", "Mine"] },
        { "text": "Nobody passes without my say.", "trade": ["Patrol", "Watch"] },
        { "text": "{culture_greeting}!", "emote": "Wave" },
        { "text": "A proper bow. Your beard does you credit.", "emote": "Bow" },
        { "text": "To the forge and the stone!", "emote": "Cheer" },
        { "text": "Dwarves don't dance. Much.", "emote": "Dance" },
        { "text": "An elf! Mind the low ceilings, beanpole.", "stance": "Rival" },
        { "text": "Pointy ears, soft hands. Ever lifted a hammer, {player}?", "stance": "Rival" },
        { "text": "Leaf-eater. Hah! Only teasing.", "stance": "Rival" },
        { "text": "A bow from an elf? Call it even.", "stance": "Rival", "emote": "Bow" },
        { "text": "Wave all you like, it won't make you taller.", "stance": "Rival", "emote": "Wave" },
        { "text": "A human. Count your fingers after, {player}.", "stance": "Wary" },
        { "text": "Tall folk. Always in a hurry.", "stance": "Wary" },
        { "text": "Off with you, {player}. I've work to do.", "stance": "Annoyed" },
        { "text": "Hmph. Humans.", "stance": "Annoyed" }
      ]
    },
    "Elf": {
      "words": {
        "culture_greeting": ["Be welcome", "Starlight on your path", "Peace, traveller"],
        "town_start": ["Ael", "Sil", "Lith", "Ith", "Calen"],
        "town_end": ["wen", "dor", "lorien", "ost", "ithil"]
      },
      "lines": [
        { "text": "The trees lend us their fallen wood. We only take that.", "trade": "Woodcutter" },
        { "text": "Moonflower and dew, the old cure.", "trade": "Healer" },
        { "text": "Even the fish sing, if you listen.", "trade": "Fisher", "mood": "Cheerful" },
        { "text": "Our herds wander where they please.", "trade": "Herder" },
        { "text": "Elven bread keeps for a season.", "trade": "Baker" },
        { "text": "Crude coin. We trade in favours here.", "trade": "Trader", "mood": "Grumpy" },
        "{culture_greeting}.",
        "The trees of {home_town} are old. Older than you.",
        "Walk softly here.",
        { "text": "The stars are bright tonight.", "when": "night" },
        { "text": "The forest wakes.", "when": "dawn" },
        { "text": "My arrows fly true. Keep that in mind.", "trade": ["Patrol", "Watch", "Hunt"] },
        { "text": "{culture_greeting}.", "emote": "Wave" },
        { "text": "Gracefully done.", "emote": "Bow" },
        { "text": "Your joy is loud.", "emote": "Cheer" },
        { "text": "You dance like a sapling in a gale.", "emote": "Dance" },
        { "text": "A dwarf, above ground? Did the tunnels run out?", "stance": "Rival" },
        { "text": "Careful, {player}. The trees here are older than your beard.", "stance": "Rival" },
        { "text": "Stout as ever. Do try not to trample the moss.", "stance": "Rival" },
        { "text": "Oh, a bow. How very... sturdy of you.", "stance": "Rival", "emote": "Bow" },
        { "text": "Yes, yes, we see you down there.", "stance": "Rival", "emote": "Wave" },
        { "text": "A {player}. You are far from your fields.", "stance": "Wary" },
        { "text": "Humans cut trees. We remember.", "stance": "Wary" },
        { "text": "Leave us, {player}.", "stance": "Annoyed" },
        { "text": "How loud you are.", "stance": "Annoyed" }
      ]
    },
    "Goblin": {
      "words": {
        "culture_greeting": ["Oi", "Wot you want", "Hehe, hello"],
        "town_start": ["Snag", "Grub", "Muck", "Rot", "Gnash"],
        "town_end": ["pit", "hole", "heap", "warren", "mire"]
      },
      "lines": [
        "{culture_greeting}?",
        "{culture_greeting}. Shinies? Got shinies?",
        "This is {home_town}. Ours. Not yours.",
        "Don't touch nothing.",
        { "text": "Is that a {player}? Looks tasty.", "weight": 0.5 },
        { "text": "Stay back or I'll bonk you.", "trade": ["Patrol", "Watch"] },
        { "text": "Wot you waving at?", "emote": "Wave" },
        { "text": "Hehe. Bow lower.", "emote": "Bow" },
        { "text": "Oi oi oi!", "emote": "Cheer" },
        { "text": "Silly dancing! Hehehe!", "emote": "Dance" },
        { "text": "Big one. Ogre-thing. Not too close.", "stance": "Wary" },
        { "text": "Watching you, {player}. Watching.", "stance": "Wary" },
        { "text": "Go away, lump.", "stance": "Annoyed" },
        { "text": "Ugh. {player}. Ugh.", "stance": "Annoyed" }
      ]
    },
    "Ogre": {
      "words": {
        "culture_greeting": ["Hrm", "Grah", "You. Small one"],
        "town_start": ["Gor", "Brug", "Mog", "Thud", "Krag"],
        "town_end": ["rock", "smash", "lump", "maw", "crag"]
      },
      "lines": [
        "{culture_greeting}.",
        "{home_town}. Mine.",
        "Hungry.",
        "Too small to eat. Go away.",
        { "text": "Sleep now. Smash later.", "when": "night" },
        { "text": "Hrm. Wave.", "emote": "Wave" },
        { "text": "Small one bows. Good.", "emote": "Bow" },
        { "text": "GRAAAH!", "emote": "Cheer" },
        { "text": "Ogre stomp too.", "emote": "Dance" },
        { "text": "Little sneaky {player}. Hands off ogre stuff.", "stance": "Wary" },
        { "text": "Hmm. Goblin smell.", "stance": "Wary" },
        { "text": "Go. Before ogre squash.", "stance": "Annoyed" },
        { "text": "Grr. Not talking to {player}.", "stance": "Annoyed" }
      ]
    },
    "Hermit": {
      "lines": [
        "Leave me be.",
        "Go on, off with you.",
        "Nobody comes out here. Why are you here?",
        { "text": "Quiet out here. I like it quiet.", "weight": 2 },
        { "text": "Don't wave at me.", "emote": "Wave" },
        { "text": "Hmph. Polite, at least.", "emote": "Bow" },
        { "text": "Keep it down!", "emote": ["Cheer", "Dance"] }
      ]
    },
    "Ghost": {
      "lines": [
        "You're new. I can tell. You still flicker.",
        "Do you remember your name? I've lost mine.",
        "They walk right through us, you know.",
        "Cold tonight. Or is it always?",
        { "text": "The living are asleep. The night is ours.", "when": "night", "weight": 2 },
        { "text": "Have you found your way back yet? Nor have I.", "weight": 2 },
        { "text": "Ooooh... oh, it's only you.", "emote": "Wave" },
        { "text": "Such manners, for the departed.", "emote": "Bow" },
        { "text": "Dancing? We drift, mostly.", "emote": ["Cheer", "Dance"] }
      ]
    }
  }
}
