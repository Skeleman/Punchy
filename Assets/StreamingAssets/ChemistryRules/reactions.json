    { "id": "e-fire-thing", "element": "fire", "if": { "lacks": ["flammable", "creature"] }, "do": [{ "status": { "burning": 9 } }] },
    { "id": "e-heat-wet", "element": "heat", "if": { "status": "wet" }, "do": [{ "clear": "wet" }], "log": "{name} steams dry" },
    { "id": "e-heat-frozen", "element": "heat", "if": { "status": "frozen" }, "do": [{ "clear": "frozen" }, { "status": { "wet": 30 } }], "log": "{name} thaws out", "stop": true },
    { "id": "e-water", "element": "water", "if": { "lacks": "creature" }, "do": [{ "clear": "burning" }, { "status": { "wet": 60 } }] },
    { "id": "e-water-creature", "element": "water", "if": { "has": "creature" }, "do": [{ "clear": "burning" }, { "statusOf": "soak" }] },
    { "id": "e-cold-wet", "element": "cold", "if": { "status": "wet", "has": "creature", "verb": "freeze" }, "do": [{ "clear": "wet" }, { "statusOf": "freeze" }], "log": "{name} is wet, and freezes solid", "notable": true, "stop": true },
