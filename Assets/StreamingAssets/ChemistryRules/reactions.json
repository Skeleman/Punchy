    { "id": "growth-clear-ash", "element": "growth", "if": { "cover": ["ash"] }, "do": [{ "setCover": null }], "stop": true },

    { "id": "thorns-into-fire", "element": "thorns", "if": { "notTerrainTag": "blocking", "fire": true }, "do": [{ "setCover": "thorns" }, { "ignite": "cover" }], "log": "Thorns burst up into the flames and catch", "notable": true, "stop": true },
    { "id": "thorns-water", "element": "thorns", "if": { "water": true }, "do": [], "stop": true },
