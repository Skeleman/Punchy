    { "id": "grease-spill", "element": "grease", "if": { "notTerrainTag": "blocking" }, "do": [{ "setCover": "grease" }], "stop": true },
    { "id": "oil-into-fire", "element": "oil", "if": { "notTerrainTag": "blocking", "fire": true }, "do": [{ "setCover": "oil" }, { "ignite": "cover" }], "log": "Oil hits the flames. Whoosh!", "notable": true, "stop": true },
    { "id": "oil-spill", "element": "oil", "if": { "notTerrainTag": "blocking" }, "do": [{ "setCover": "oil" }], "stop": true },

    { "id": "acid-cover", "element": "acid", "do": [{ "dissolve": "cover" }], "log": "The acid eats the {cover} away" },
