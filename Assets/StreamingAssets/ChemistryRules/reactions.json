    { "id": "heat-thaw", "element": "heat", "if": { "terrainTag": "thaws" }, "do": [{ "thaw": true }], "log": "The {terrain} melts and its meltwater rushes out", "notable": true, "stop": true },
    { "id": "heat-ice", "element": "heat", "if": { "frozen": true }, "do": [{ "melt": true }], "log": "Ice melts back into water" },
