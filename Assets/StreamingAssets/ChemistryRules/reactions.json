    { "id": "mud-soil", "element": "mud", "if": { "terrainTag": "soil" }, "do": [{ "setTerrain": "mud" }, { "addWater": 1 }], "log": "The ground churns to mud", "stop": true },
    { "id": "mud-turf", "element": "mud", "if": { "terrainTag": "turf" }, "do": [{ "setTerrain": "mud" }, { "addWater": 1 }], "log": "The ground churns to mud", "stop": true },
    { "id": "dust-cloud", "element": "dust", "if": { "notTerrainTag": "blocking" }, "do": [{ "gas": "dust", "n": 4 }], "stop": true },
