  ],
  "entity": [
    { "id": "e-fire-wet", "element": "fire", "if": { "status": "wet" }, "do": [{ "clear": "wet" }], "log": "{name} is soaked, so the fire only sizzles", "stop": true },
    { "id": "e-fire-frozen", "element": "fire", "if": { "status": "frozen" }, "do": [{ "clear": "frozen" }, { "status": { "wet": 30 } }], "log": "{name} thaws out", "stop": true },
