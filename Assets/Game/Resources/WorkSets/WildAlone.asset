  m_Script: {fileID: 11500000, guid: 1a0f974c856d8a6448cefd4ea2d5904b, type: 3}
  m_Name: WildAlone
  m_EditorClassIdentifier: Assembly-CSharp::Punchy.Fauna.FolkWorkSet
  Biomes: []
  Jobs: []
  AloneLines:
  - "Just me, the birds and the weather. Suits me fine."
  - "{name}, you've got to stop talking to yourself. ...No, I don't."
  - "Folk in town want to know my business. Out here, nobody asks."
  - "Quiet day. Good day."
  - "Wonder if anyone remembers I'm out here. Hope not."
