// GPU culling and level-of-detail selection for FloraSystem. For every plant in a layer: skip it if it's outside
// the view (with a margin near the camera so off-screen plants still cast shadows), pick its LOD by distance, and
// append it to that variant/LOD's list, bumping the instance count in the indirect draw arguments. Across each LOD
// change (and the fade-out at the layer's radius) a plant is appended to both levels with a dither fade:
//   fade  t >= 0  draw where dither <  t
//   fade -t <  0  draw where dither >= t        (the two halves of a crossfade never overlap)
// W-102: the camera's lists cast no shadows. Plants near enough to cast (the layer's cast distance) also go, once
// each, into a shadow list per variant at LOD 0 or 1 (the outgoing level through a change, as shadows don't
// crossfade), so the shadow cascades never draw the far plants the camera sees. Far natural plants also thin out
// (see _Thin); rocks and built things never do.
// Refactor 3.5c / 3.3 (DetailPolicy.FloraRule): each variant's own class and size set its mesh changes, how far it's drawn
// and how far it casts, from _ModelReach, not its layer's distances; the layer's values stay as ceilings. A plant's
// real-time shadow has hysteresis (_FloraCastState), so one hovering at its limit doesn't flicker.

#pragma kernel Clear
#pragma kernel Cull

struct FloraInstance
{
    float3 position;
    float yaw;
    float scale;
    int model;
    float random;
    float snow;
    float2 tilt;   // the ground normal's x and z: rocks lie on the slope
    uint ground;   // RGB8 ground colour round a built thing's footprint and, in alpha, the dirt band's height (cm; 0: none)
};

StructuredBuffer<FloraInstance> _FloraInstances;
StructuredBuffer<float3> _ModelBounds;   // radius, centre height (unscaled), thins (1: a natural plant), per variant
StructuredBuffer<uint> _Regions;         // output offset per variant × draw (3 LODs, then 2 shadow lists)
// Per variant: how far (m per reference pixel-per-metre, at scale 1) it keeps x LOD 0, y LOD 1, z being drawn, w casting.
StructuredBuffer<float4> _ModelReach;
// Per plant: 1 if it cast last frame. Left alone across uploads: a plant only reads it inside the hysteresis band.
RWStructuredBuffer<uint> _FloraCastState;
RWStructuredBuffer<uint2> _FloraVisible; // instance index, asuint(fade)
// IndirectDrawIndexedArgs, one per variant x LOD. Structured, not raw: D3D11 can't write an IndirectArguments buffer as
// raw, so FloraSystem counts into this and copies it into the draws' arguments.
struct DrawArgs
{
    uint indexCount;
    uint instanceCount;
    uint startIndex;
    int baseVertex;
    uint startInstance;
};
RWStructuredBuffer<DrawArgs> _Args;      // IndirectDrawIndexedArgs per variant × draw (5 uints)

uint _Count;
uint _DrawCount;
int _ModelBase;
float4 _Planes[6];
float3 _CameraPosition;
float4 _Lod;      // x LOD1 distance, y LOD2 distance, z radius
// x cast distance (0: the layer casts none), y margin off-screen, z where the shadow list changes to its second
// level (0: the LOD 1 change; W-107's cheap far caster sets the near range), w skip plants nearer than this (W-107's
// shadow cache: the near trees cast in real time)
float4 _Shadow;
// W-107's still far shadows: where the shadow lists stop swaying (m; 0: never). A shadow-list plant's fade is 1 plus
// how still it is (the shadow pass reads it; fades of 1 and above all cast).
float _ShadowStill;
float4 _Thin;     // x distance natural plants start thinning, y share of them left at the radius
float4 _Reach;    // x geometry's, y shadows' reference pixels per metre at the graphics settings (x 0: the layer's distances, "-oldfloralod")
float _CastHold;  // 1: use and update _FloraCastState (the camera's cull; not the shadow cache's)

[numthreads(64, 1, 1)]
void Clear(uint id : SV_DispatchThreadID)
{
    if (id < _DrawCount)
        _Args[id].instanceCount = 0;
}

#define DRAWS 5

void Append(uint instance, uint local, uint lod, float fade)
{
    uint draw = local * DRAWS + lod;
    uint slot;
    InterlockedAdd(_Args[draw].instanceCount, 1, slot);
    _FloraVisible[_Regions[draw] + slot] = uint2(instance, asuint(fade));
}

[numthreads(64, 1, 1)]
void Cull(uint id : SV_DispatchThreadID)
{
    if (id >= _Count)
        return;
    FloraInstance plant = _FloraInstances[id];
    uint local = (uint)(plant.model - _ModelBase);
    float3 bounds = _ModelBounds[local];
    float radius = bounds.x * plant.scale;
    float3 centre = plant.position + float3(0, bounds.y * plant.scale, 0);
    float distance = length(centre - _CameraPosition);
    if (distance - radius > _Lod.z)
        return;

    float lod1 = _Lod.x, lod2 = _Lod.y, drawn = _Lod.z, castTo = _Shadow.x;
    if (_Reach.x > 0)
    {
        float4 reach = _ModelReach[local] * plant.scale;
        lod1 = reach.x * _Reach.x;
        lod2 = reach.y * _Reach.x;
        drawn = min(drawn, reach.z * _Reach.x);
        castTo = min(castTo, reach.w * _Reach.y);
    }

    // Plants a little off-screen still cast into the view; the camera's own lists take only the visible ones.
    bool casts = distance - radius < castTo;
    if (_CastHold > 0)
    {
        // Past the limit a caster goes on casting a little further (as DetailPolicy.Hysteresis: 1 / 0.85).
        bool was = _FloraCastState[id] != 0;
        casts = casts || (was && distance - radius < castTo * 1.176);
        if (was != casts)
            _FloraCastState[id] = casts ? 1 : 0;
    }
    float margin = casts ? _Shadow.y : 0;
    bool seen = true;
    [unroll]
    for (int p = 0; p < 6; p++)
    {
        float side = dot(_Planes[p].xyz, centre) + _Planes[p].w;
        if (side < -(radius + margin))
            return;
        seen = seen && side >= -radius;
    }

    // LOD distance: to the nearest point of the plant's upright span (base to top), which suits tall trees better than
    // its centre. Item 29: this was the distance on the ground plane alone, so from high above the plants straight below
    // counted as near and went to LOD 0, whose draw FloraSystem skips by the 3D distance: they vanished, and their
    // shadows with them, while plants off to the side still showed.
    float top = plant.position.y + 2 * bounds.y * plant.scale;
    float gap = max(0, max(plant.position.y - _CameraPosition.y, _CameraPosition.y - top));
    float d = length(float3(plant.position.xz - _CameraPosition.xz, gap));
    if (d < _Shadow.w)
        return;
    if (casts)
        // (_Shadow.z from 1e5: the shadow cache, whose trees all stay on the first list.)
        Append(id, local, _Shadow.z >= 1e5 || d < (_Shadow.z > 0 ? min(_Shadow.z, lod1 * 1.075) : lod1 * 1.075) ? 3 : 4,
               1 + (_ShadowStill > 0 ? smoothstep(_ShadowStill - 5, _ShadowStill + 5, d) : 0));
    if (!seen)
        return;
    float keep = 1 - smoothstep(drawn * 0.88, drawn, d);
    // W-102: natural plants thin out past _Thin.x. Each has its own threshold in the falling share, and dithers away
    // over a tenth of it, so the thinning has no line: plants drop out one by one, scattered over the distance.
    if (bounds.z > 0)
    {
        float share = lerp(1, _Thin.y, smoothstep(_Thin.x, _Lod.z, d));
        keep *= saturate((share * 1.1 - frac(plant.random * 61.7)) * 10);
    }
    if (keep <= 0)
        return;

    float band1 = lod1 * 0.15, band2 = lod2 * 0.15;
    float t1 = saturate((d - (lod1 - band1 * 0.5)) / band1);
    float t2 = saturate((d - (lod2 - band2 * 0.5)) / band2);
    if (t1 <= 0)
        Append(id, local, 0, keep);
    else if (t1 < 1)
    {
        Append(id, local, 0, -t1);
        Append(id, local, 1, t1);
    }
    else if (t2 <= 0)
        Append(id, local, 1, keep);
    else if (t2 < 1)
    {
        Append(id, local, 1, -t2);
        Append(id, local, 2, t2);
    }
    else
        Append(id, local, 2, keep);
}
